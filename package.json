{
  "name": "wam-mfugo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "deepmerge-ts": "^8.0.0",
    "image-size": "^2.0.0",
    "uuid": "^11.1.1"
  },
  "scripts": {
    "dev:web": "npm run dev -w apps/web",
    "build:web": "npm run build -w apps/web",
    "preview:web": "npm run preview -w apps/web",
    "lint:web": "npm run lint -w apps/web",
    "test:web": "npm run test:run -w apps/web",
    "test:web:watch": "npm run test -w apps/web",
    "dev:api": "npm run start:dev -w apps/api",
    "build:api": "npm run build -w apps/api",
    "start:api": "npm run start:prod -w apps/api",
    "test:api": "npm run test -w apps/api",
    "test:api:e2e": "npm run test:e2e -w apps/api",
    "prisma:generate": "npm run prisma:generate -w apps/api",
    "dev:mobile": "npm run start -w apps/mobile",
    "typecheck:mobile": "npm run typecheck -w apps/mobile",
    "lint:all": "npm run lint:web && npm run lint -w apps/api && npm run lint -w apps/mobile",
    "typecheck:all": "npm run typecheck -w apps/mobile && npm run typecheck -w apps/web && npm run typecheck -w apps/api",
    "test:all": "npm run test:web && npm run test:api && npm run test -w apps/mobile",
    "build:all": "npm run build:web && npm run build:api"
  }
}
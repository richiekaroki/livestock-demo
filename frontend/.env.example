# ============================================
# MIFUGO360 ENVIRONMENT CONFIGURATION
# ============================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control!

# --------------------------------------------
# KALRO API Configuration
# Kenya Agricultural and Livestock Research Organisation
# --------------------------------------------
VITE_KALRO_API_URL=https://api.kalro.go.ke/v1
VITE_KALRO_CLIENT_ID=your_kalro_client_id_here
VITE_KALRO_CLIENT_SECRET=your_kalro_client_secret_here
VITE_ENABLE_KALRO_SYNC=true

# --------------------------------------------
# KIAMIS Configuration
# Kenya Integrated Agriculture Management Information System
# --------------------------------------------
VITE_KIAMIS_API_URL=https://api.kiamis.go.ke/v2
VITE_KIAMIS_API_KEY=your_kiamis_api_key_here

# --------------------------------------------
# AWS Configuration (MifugoLink Infrastructure)
# --------------------------------------------
VITE_AWS_REGION=af-south-1
VITE_AWS_S3_BUCKET=mifugo360-biometrics
VITE_AWS_RDS_ENDPOINT=mifugo360-db.xxxx.af-south-1.rds.amazonaws.com
VITE_AWS_ACCESS_KEY_ID=your_aws_access_key
VITE_AWS_SECRET_ACCESS_KEY=your_aws_secret_key

# --------------------------------------------
# Feature Flags
# --------------------------------------------
VITE_OFFLINE_MODE=true
VITE_AUTO_SYNC=true
VITE_ENABLE_BIOMETRIC_CAPTURE=true

# --------------------------------------------
# Development Settings
# --------------------------------------------
VITE_API_TIMEOUT=10000
VITE_RETRY_ATTEMPTS=3
VITE_LOG_LEVEL=debug

# --------------------------------------------
# Production URLs (uncomment for production)
# --------------------------------------------
# VITE_API_BASE_URL=https://api.mifugo360.co.ke
# VITE_CDN_URL=https://cdn.mifugo360.co.ke
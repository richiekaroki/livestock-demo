generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AnimalType {
  Cattle
  Goat
  Sheep
  Camel
  Pig
  Chicken
}

enum HealthStatus {
  Healthy
  Sick
  UNDER_TREATMENT @map("Under Treatment")
  Recovered
}

model Farmer {
  id        Int      @id @default(autoincrement())
  code      String   @unique
  name      String
  phone     String
  county    String
  subCounty String
  animals   Animal[]
  createdAt DateTime @default(now())

  @@map("farmers")
}

model User {
  id               Int       @id @default(autoincrement())
  email            String    @unique
  name             String
  phone            String
  role             String    @default("farmer")
  permissions      String    @default("[]")
  county           String
  subCounty        String?
  isActive         Boolean   @default(true)
  failedOtpAttempts Int      @default(0)
  lockedUntil      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  animals          Animal[]
  sessions         Session[]
  auditLogs        AuditLog[]
  pushTokens       PushToken[]

  @@map("users")
}

model OtpCode {
  id        Int      @id @default(autoincrement())
  email     String
  code      String
  expiresAt DateTime
  used      Boolean  @default(false)
  purpose   String
  createdAt DateTime @default(now())

  @@map("otp_codes")
}

model Session {
  id              Int      @id @default(autoincrement())
  userId          Int
  refreshTokenHash String
  device          String?
  ip              String?
  lastActive      DateTime @default(now())
  expiresAt       DateTime
  createdAt       DateTime @default(now())
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  event      String
  email      String?
  userId     Int?
  ip         String?
  userAgent  String?
  beforeValue String?
  afterValue  String?
  metadata   String?
  archivedAt DateTime?
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
}

model Animal {
  id           Int       @id @default(autoincrement())
  name         String
  type         AnimalType
  breed        String?
  health       HealthStatus
  county       String
  owner        String
  lat          Float
  lng          Float
  createdAt    DateTime  @default(now())
  archivedAt   DateTime?
  biometric    String?
  govReg       String?
  farmerId     Int?
  farmer       Farmer?   @relation(fields: [farmerId], references: [id], onDelete: SetNull)
  userId       Int?
  user         User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  vaccinations Vaccination[]
  diseases     Disease[]
  mortalities  Mortality[]
  weightRecords WeightRecord[]

  @@map("animals")
}

model Vaccination {
  id           Int      @id @default(autoincrement())
  type         String
  date         DateTime
  batchNumber  String
  veterinarian String
  nextDueDate  DateTime?
  animalId     Int
  animal       Animal   @relation(fields: [animalId], references: [id], onDelete: Cascade)

  @@map("vaccinations")
}

model Disease {
  id           Int      @id @default(autoincrement())
  name         String
  reportedDate DateTime
  status       String
  treatment    String?
  treatedBy    String?
  animalId     Int
  animal       Animal   @relation(fields: [animalId], references: [id], onDelete: Cascade)

  @@map("diseases")
}

model Outbreak {
  id               Int      @id @default(autoincrement())
  diseaseType      String
  affectedAnimals  Int
  suspectedAnimals Int
  county           String
  lat              Float
  lng              Float
  reportedBy       String
  reportedAt       DateTime @default(now())
  status           String   @default("reported")
  symptoms         Json     @default("[]")
  actions          Json     @default("[]")

  @@map("outbreaks")
}

model PushToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@map("push_tokens")
}

model SyncLog {
  id         Int      @id @default(autoincrement())
  action     String
  status     String
  payload    String?
  createdAt  DateTime @default(now())

  @@map("sync_logs")
}

model DiseaseRisk {
  id             Int      @id @default(autoincrement())
  county         String
  diseaseType    String
  riskLevel      String   @default("low")
  confidence     Float    @default(0)
  factors        Json     @default("[]")
  lastCalculated DateTime @default(now())
  createdAt      DateTime @default(now())

  @@unique([county, diseaseType])
  @@map("disease_risks")
}

model Mortality {
  id            Int      @id @default(autoincrement())
  animalId      Int
  animal        Animal   @relation(fields: [animalId], references: [id], onDelete: Cascade)
  cause         String
  diseaseName   String?
  reportedBy    String
  reportedAt    DateTime @default(now())
  notes         String?
  createdAt     DateTime @default(now())

  @@map("mortalities")
}

model WeightRecord {
  id         Int      @id @default(autoincrement())
  animalId   Int
  animal     Animal   @relation(fields: [animalId], references: [id], onDelete: Cascade)
  weight     Float
  unit       String   @default("kg")
  recordedAt DateTime @default(now())
  recordedBy String
  notes      String?
  createdAt  DateTime @default(now())

  @@index([animalId, recordedAt])
  @@map("weight_records")
}
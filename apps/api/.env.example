# ============================================
# WAM MFUGO API ENVIRONMENT CONFIGURATION
# ============================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control!

# Postgres connection string (Neon / Supabase free tier)
# When unset, the API runs in-memory (demo mode, no database required).
DATABASE_URL=postgresql://user:password@host:5432/wam_mfugo

# Server
PORT=4000

# CORS origin for the web app (Vercel)
# VITE_CORS_ORIGIN=https://your-app.vercel.app

# KALRO / KIAMIS integration (optional — when set, real requests are attempted)
# KALRO_API_URL=
# KALRO_CLIENT_ID=
# KALRO_CLIENT_SECRET=
# KIAMIS_API_URL=
# KIAMIS_API_KEY=

# --------------------------------------------
# Authentication (Email OTP — passwordless)
# --------------------------------------------
JWT_SECRET=change-me-to-a-random-string
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
OTP_EXPIRY_MINUTES=5
OTP_MAX_REQUESTS=5
OTP_LOCKOUT_MINUTES=15
DEFAULT_ADMIN_EMAIL=rkabue23@gmail.com

# Email provider: "console" (logs OTP to terminal) or "smtp" (sends real email)
EMAIL_PROVIDER=console
# Brevo SMTP (production)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=b4bec8001@smtp-brevo.com
SMTP_PASS=your-smtp-key-here
SMTP_FROM=Wam Mfugo <noreply@wamfugo.com>

# Feature flags
# ENABLE_GOV_MOCK=true
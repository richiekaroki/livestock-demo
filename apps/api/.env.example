# WAM MFUGO API — ENVIRONMENT CONFIGURATION
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control!

# Postgres connection string (leave blank for in-memory demo mode)
DATABASE_URL=

# Server
PORT=4000

# CORS (allow web dev server)
CORS_ORIGIN=http://localhost:5173

# Authentication (Email OTP — passwordless)
JWT_SECRET=replace-with-random-64-char-hex
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
OTP_EXPIRY_MINUTES=5
OTP_MAX_REQUESTS=5
OTP_LOCKOUT_MINUTES=15
DEFAULT_ADMIN_EMAIL=demo@wamfugo.ke

# Email provider: "console" (dev) or "smtp" (production)
EMAIL_PROVIDER=console

# Dev auto-verify: skip OTP step in dev (auto-login for rapid testing)
DEV_AUTO_VERIFY=false

# Base URL for invitation registration links
WEB_BASE_URL=http://localhost:5173

# SMTP (only needed when EMAIL_PROVIDER=smtp)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your-brevo-smtp-user
SMTP_PASS=your-brevo-smtp-password
SMTP_FROM=Wam Mfugo <noreply@yourdomain.com>

# Brevo REST API (optional)
BREVO_API_KEY=your-brevo-api-key

# New Relic APM (optional - for production monitoring)
NEW_RELIC_ENABLED=false
NEW_RELIC_LICENSE_KEY=your-new-relic-license-key
NEW_RELIC_APP_NAME=Wam Mfugo API
NEW_RELIC_LOG_LEVEL=info

# Sentry Error Tracking (optional - for production error monitoring)
SENTRY_DSN=your-sentry-dsn
SENTRY_TRACES_SAMPLE_RATE=0.1

# Cache Configuration (optional - for performance optimization)
CACHE_TTL=300
CACHE_MAX=100
